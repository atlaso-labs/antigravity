{
  "atlaso": {
    "enabled": true,
    "SessionStart": [
      { "type": "command", "command": "./hooks/start.sh", "timeout": 15 }
    ],
    "PreInvocation": [
      { "type": "command", "command": "./hooks/recall.sh", "timeout": 15 }
    ],
    "Stop": [
      { "type": "command", "command": "./hooks/capture.sh", "timeout": 30 }
    ]
  }
}
